{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-meti",
  "compatibility_date": "2026-04-13",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],

  // ── 실서버 (main 브랜치) ──────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-meti-production",
      "database_id": "0556e138-ceb8-41c9-9bd4-bc3a7d28bcb4"
    }
  ],

  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "the-meti-storage"
    }
  ],

  "vars": {
    "APP_NAME": "ELID",
    "APP_ENV": "production",
    "JWT_EXPIRES_IN": "7d",
    "REFRESH_TOKEN_EXPIRES_IN": "30d",
    // 파트너 SSO 공개 파라미터 (개인키는 secret) — 배포 시 vars가 대시보드
    // plain_text 변수를 대체하므로 공개값은 반드시 여기서 관리한다
    "PARTNER_JWT_KID": "elid-partner-2026-08",
    "PARTNER_JWT_ISS": "https://my-elid.com",
    // 트랜잭션 메일 (키는 BREVO_API_KEY secret) — 미설정 시 비밀번호 재설정 503
    "EMAIL_FROM": "ELID <noreply@my-elid.com>",
    "APP_BASE_URL": "https://my-elid.com",
    // ── Android App Links (앱 전달 2026-08-20) ──
    // 지문은 assetlinks.json으로 공개 서빙되는 값이라 vars가 맞다(secret 아님).
    // ⚠ Play App Signing 사용 시 Play가 재서명한 키의 SHA256이 별도로 생긴다 —
    //    스토어 등록 후 그 값을 콤마로 이어붙일 것(배열로 함께 나간다).
    "ANDROID_PACKAGE": "com.elid.app",
    "ANDROID_SHA256": "09:8F:95:55:28:1A:EC:9C:91:DD:9B:E8:03:06:93:7B:68:70:9F:ED:17:63:98:FC:CE:6B:F1:2F:BF:9E:5E:72",
    // B-2 잔액조회 (키는 HT_PARTNER_KEY secret) — 해피트리 prod 등록 완료(2026-08-20)로 활성.
    // 해피트리는 단일 배포 + 파트너 레지스트리로 staging/prod를 구분하므로 base는 preview와 같다.
    "HT_BALANCE_BASE_URL": "https://happy-tree-game.pages.dev"
    // APPLE_APP_ID 는 Apple 계정 신규 개설 후 <TeamID>.com.elid.app 로 주입
    // (미설정 시 apple-app-site-association 은 빈 연관 — iOS는 capability 연결 전이라 무해)
  },

  // ── 스테이징 (staging 브랜치 → Cloudflare preview 환경) ─
  // Cloudflare Pages는 "preview" / "production" 두 가지만 지원
  // staging 브랜치 배포 시 --env preview 로 사용
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "the-meti-staging",
          "database_id": "5ebff506-d8a7-44dd-91ff-6dc805df4511"
        }
      ],
      "r2_buckets": [
        {
          "binding": "STORAGE",
          "bucket_name": "the-meti-storage"
        }
      ],
      "vars": {
        "APP_NAME": "ELID",
        "APP_ENV": "staging",
        "JWT_EXPIRES_IN": "7d",
        "REFRESH_TOKEN_EXPIRES_IN": "30d",
        "PARTNER_JWT_KID": "elid-partner-stg-2026-08",
        "PARTNER_JWT_ISS": "https://staging.the-meti.pages.dev",
        // B-2 잔액조회: 해피트리 API 베이스 (키는 HT_PARTNER_KEY secret)
        // 해피트리는 단일 배포 + 파트너 레지스트리로 staging/prod 구분
        "HT_BALANCE_BASE_URL": "https://happy-tree-game.pages.dev",
        // 트랜잭션 메일 — 발신 도메인은 prod와 공용(Brevo에서 my-elid.com 1회 검증),
        // 링크만 스테이징으로 향한다
        "EMAIL_FROM": "ELID <noreply@my-elid.com>",
        "APP_BASE_URL": "https://staging.the-meti.pages.dev",
        // App Links — vars는 환경 간 상속되지 않아 preview에도 같은 값을 둔다.
        // 앱 intent-filter는 my-elid.com만 등록돼 있어 스테이징에서 실검증이
        // 일어나진 않지만, 값을 비워두면 배포마다 wrangler 경고가 뜬다.
        "ANDROID_PACKAGE": "com.elid.app",
        "ANDROID_SHA256": "09:8F:95:55:28:1A:EC:9C:91:DD:9B:E8:03:06:93:7B:68:70:9F:ED:17:63:98:FC:CE:6B:F1:2F:BF:9E:5E:72"
        // TOSS_CLIENT_KEY / TOSS_SECRET_KEY 는 secret으로 관리
        // (wrangler pages secret put — vars 평문 금지: Pages는 배포 시 vars가
        //  대시보드 secret을 덮어쓰므로 실키가 이 자리에 들어가는 순간 사고가 된다)
      }
    }
  },

  // ── Cron Triggers ─────────────────────────────────────────────
  // 주의: Cloudflare Pages는 triggers 블록 미지원
  // 만료 채팅 삭제는 /cdn-cgi/handler/scheduled 엔드포인트로 수동 호출 가능
  // (추후 별도 Worker로 분리 예정)

  // Secrets (wrangler pages secret put 으로 설정):
  // JWT_SECRET
  // PARTNER_WEBHOOK_SECRET
  // FCM_SERVICE_ACCOUNT  — Firebase 서비스 계정 키 JSON 원문 (앱팀이 프로젝트 생성 후 전달, 미설정 시 푸시 자동 비활성)
  // TOSS_CLIENT_KEY / TOSS_SECRET_KEY — 토스페이먼츠 키 (미설정 시 충전 비활성)
  // PARTNER_JWT_PRIVATE_KEY — 파트너 SSO launch-token RS256 개인키(PKCS8 PEM, 미설정 시 발급 비활성)
  // PARTNER_JWT_KID         — JWKS kid (기본 elid-partner-2026-08)
  // PARTNER_JWT_ISS         — launch-token iss (prod=https://my-elid.com, 2026-08-08 확정)
  // HT_PARTNER_KEY          — 해피트리 발급 X-HT-Partner-Key (B-2 잔액조회. 미설정 시 503 비활성)
  // BREVO_API_KEY           — Brevo API 키 (비밀번호 재설정 메일. 미설정 시 503 비활성)
  //                           발신 도메인 my-elid.com의 SPF/DKIM 검증 선행 필요
  //                           ⚠ prod는 해피트리가 ELID prod 파트너를 등록한 뒤에 설정한다
  //                           (prod vars에 HT_BALANCE_BASE_URL도 그때 추가)
}
