# 로컬 개발용 시크릿 — 복사해서 .dev.vars 로 사용 (.dev.vars는 커밋 금지)
JWT_SECRET=change-me
PARTNER_WEBHOOK_SECRET=change-me

# 토스페이먼츠 (미설정 시 충전 비활성) — docs 공개 테스트 키 사용 가능
# TOSS_CLIENT_KEY=test_ck_...
# TOSS_SECRET_KEY=test_sk_...

# FCM 푸시 (미설정 시 푸시 비활성) — Firebase 서비스 계정 키 JSON 원문
# FCM_SERVICE_ACCOUNT={"project_id":...}

# 파트너 SSO launch-token (미설정 시 발급 비활성 / JWKS 빈 keys)
# RS256 개인키 PKCS8 PEM — 한 줄로 넣을 땐 개행을 \n 으로. 생성:
#   node -e "const{generateKeyPairSync}=require('crypto');console.log(generateKeyPairSync('rsa',{modulusLength:2048}).privateKey.export({type:'pkcs8',format:'pem'}).toString())"
# PARTNER_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# PARTNER_JWT_KID=elid-partner-local
# PARTNER_JWT_ISS=http://localhost:3000

# B-2 파트너 잔액조회 (해피트리) — 미설정 시 503 비활성
# HT_PARTNER_KEY=htpk_...
# HT_BALANCE_BASE_URL=https://happy-tree-game.pages.dev

# 트랜잭션 메일 (Brevo) — 미설정 시 비밀번호 재설정 503
# 헤더명이 api-key다 (Bearer 아님). 로컬 테스트는 Brevo 대시보드에서 검증된 발신자 필요
# BREVO_API_KEY=xkeysib-...
# EMAIL_FROM=ELID <noreply@my-elid.com>
# APP_BASE_URL=http://localhost:3000
